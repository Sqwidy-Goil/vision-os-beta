{
  "name": "vision-os-beta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VISI0N OS BETA — a privacy-first spatial computing PWA for iPhone Safari.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
